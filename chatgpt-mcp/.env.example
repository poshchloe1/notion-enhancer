# Copy to .env (for local testing) or set these in your MCP client config.

# REQUIRED — your OpenAI / ChatGPT API key. All generation is billed here.
OPENAI_API_KEY=sk-your-openai-key

# OPTIONAL — default model used when a tool call doesn't specify one.
OPENAI_MODEL=gpt-4o-mini

# OPTIONAL — override the API base (e.g. an OpenAI-compatible gateway).
OPENAI_BASE_URL=https://api.openai.com/v1

# OPTIONAL — OpenAI org / project scoping.
# OPENAI_ORG=org-...
# OPENAI_PROJECT=proj_...

# --- Only needed when hosting for the Claude web/mobile app (HTTP mode) ---
# MCP_TRANSPORT=http
# PORT=3000
# Shared secret clients must send as "Authorization: Bearer <token>".
# MCP_AUTH_TOKEN=change-me-to-a-long-random-string
